# Copy to .env and adjust. .env is git-ignored: never commit real credentials.
# Both docker-compose.yml (POSTGRES_*) and Prisma (DATABASE_URL) read this file.

POSTGRES_USER=postgres
# Development default. Replace it for anything shared, and URL-encode it in
# DATABASE_URL below if it contains characters such as @ : / ? # or %.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cantantes
POSTGRES_PORT=5432

# Host is 127.0.0.1 (IPv4 loopback): Docker binds IPv4 only here,
# so plain "localhost" can fail when it resolves to ::1.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cantantes?schema=public

# API runtime. Read by apps/api through @nestjs/config (repository-root .env).
# Port 3001 keeps the API next to the Next.js dev server on 3000.
PORT=3001
# Comma-separated CORS allowlist. Only these origins may call the read-only API.
WEB_ORIGIN=http://localhost:3000
