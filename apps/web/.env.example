# Copy to `.env.local` (git-ignored) for local development, or set the variable in
# the deployment environment.

# Base URL of the NestJS API, consumed by the server-only layer in `apps/web/lib/api`.
# Server-only on purpose: it does NOT use the `NEXT_PUBLIC_` prefix, so the API
# origin is never shipped to the browser. See `docs/frontend/api-integration.md`.
# The API listens on 3001 by default; the Next.js dev server uses 3000.
API_BASE_URL=http://localhost:3001
