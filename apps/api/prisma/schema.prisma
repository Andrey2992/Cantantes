// Prisma schema: persistence concerns only.
//
// The datasource URL is intentionally absent. On Prisma 7 it is configured in
// `prisma7.config.ts` and read from the repository-root `.env`, which is also
// what `docker-compose.yml` uses to start PostgreSQL.
//
// Models added here describe the database, not the domain. The generated client
// (`src/generated/prisma`, git-ignored) must only be imported from the
// infrastructure layer, never from domain code (AGENTS.md §13). It lives inside
// `src` so `nest build` can compile it under this package's `rootDir`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Persistence shape of a portfolio project.
///
/// This is a storage concern, not the domain entity: the API never returns these
/// rows directly. `infrastructure/repositories/PrismaProjectRepository.ts` maps
/// each row into the `Project` aggregate, which re-validates every invariant
/// (AGENTS.md sections 8 and 13).
model Project {
  /// Opaque identifier produced by the write path. The domain never parses it,
  /// so no database-side default is declared here.
  id String @id

  /// Public URL identity (Stitch PRD section 6, Phase 6). Canonical kebab-case,
  /// guaranteed by the domain before a row can be written.
  slug String @unique

  /// Single-line display text used by the typographic index (PRD 3.2) and the
  /// contextual badge (PRD 3.5).
  title String

  /// Atmospheric gradient stops and accent of this project state (PRD 3.4).
  /// Stored as `#rrggbb`, normalized by the domain.
  themeFrom   String @map("theme_from")
  themeTo     String @map("theme_to")
  themeAccent String @map("theme_accent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

/// Persistence shape of a professional experience record.
///
/// Storage concern only: `infrastructure/repositories/PrismaExperienceRepository.ts`
/// maps each row into the `Experience` aggregate, which re-validates every
/// invariant (AGENTS.md sections 8 and 13). Rows enter through an authoring
/// migration; the API never invents records (AGENTS.md section 23).
model Experience {
  id        String    @id
  company   String
  role      String
  /// Optional description. `NULL` when no summary was authored.
  summary   String?
  startDate DateTime  @map("start_date")
  /// `NULL` while the role is ongoing.
  endDate   DateTime? @map("end_date")

  @@map("experiences")
}

/// Persistence shape of a skill entry.
///
/// Storage concern only: `infrastructure/repositories/PrismaSkillRepository.ts`
/// maps each row into the `Skill` aggregate (AGENTS.md sections 8 and 13).
model Skill {
  id       String  @id
  name     String
  /// Optional grouping label. `NULL` when the skill is uncategorized.
  category String?

  @@map("skills")
}

/// Persistence shape of a contact message received through the portfolio form.
///
/// Storage concern only: `infrastructure/repositories/PrismaContactMessageRepository.ts`
/// persists the validated `ContactMessage` aggregate (AGENTS.md sections 8 and 13).
/// Messages are append-only; nothing is exposed back over HTTP.
model ContactMessage {
  id        String   @id
  name      String
  email     String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}
